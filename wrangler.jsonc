{
  "name": "arithmetic-racer",
  "main": "server/server.js",
  "compatibility_date": "2026-05-06",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  // Ships Worker logs to Cloudflare's Observability backend so `kind`-tagged
  // lines from worker/logger.js are queryable. Sampling is 1 (keep everything)
  // because current traffic is low enough that full retention is cheap and
  // partial sampling makes rare errors unfindable. Revisit if volume grows.
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "arithmetic-racer",
      "database_id": "f8177dfe-30fe-4d05-931b-cfdb30a6e696"
    }
  ],
  // Cloudflare mints a new Worker Version id on every deploy, which is the only
  // "which build is this?" answer that needs no human diligence — package.json's
  // version is bumped by hand and never has been. worker/version.js reads it and
  // bug reports record it. Repeated under env.preview because a named env does
  // not inherit bindings from the top level.
  "version_metadata": {
    "binding": "CF_VERSION_METADATA"
  },
  "durable_objects": {
    "bindings": [
      { "name": "RaceRoom",       "class_name": "RaceRoom" },
      { "name": "PublicRaceRoom", "class_name": "PublicRaceRoom" },
      { "name": "LobbyRouter",    "class_name": "LobbyRouter" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["RaceRoom"] },
    { "tag": "v2", "new_sqlite_classes": ["PublicRaceRoom", "LobbyRouter"] }
  ],
  // Rate limiting for the public routes — POST /api/race-result and, further
  // down, GET /api/leaderboard. `period` accepts only 10 or 60, and counters
  // are per-colo — so these are floors on what a distributed client can send,
  // not global ceilings.
  //
  // 6/min/device: a race is 10 problems (RACE_LENGTH) and the game's own
  // human-speed model peaks at 35 problems/min, so an easy-mode cycle runs
  // ~30s — about 2 races a minute. 6 leaves 3x headroom over the fastest real
  // player while still capping a script. The superseded spec said 30/hour,
  // which sat ~4x *below* a legitimate easy-mode grinder; Batch 3's streak
  // counter is designed to encourage exactly that grinding.
  //
  // namespace_id is an arbitrary but stable id per limiter — changing one
  // resets its counters. Preview uses its own ids so its traffic cannot eat
  // production's budget.
  "ratelimits": [
    {
      "name": "RACE_RESULT_LIMIT",
      "namespace_id": "1001",
      "simple": { "limit": 6, "period": 60 }
    },
    // Coarse per-IP ceiling, keyed separately from device. IP-only keying would
    // read a NAT'd classroom or family as one abusive client, and that is a
    // plausible audience for a math game. 60/min is ~30 devices racing flat out
    // behind a single address.
    {
      "name": "RACE_RESULT_IP_LIMIT",
      "namespace_id": "1002",
      "simple": { "limit": 60, "period": 60 }
    },
    // Backstop on the public boards. GET /api/leaderboard is unauthenticated
    // and the all-time board scans race_results.
    //
    // Sized against the false positive, not against the script. A scripted
    // sweep is 3 difficulties x 5 periods x 50 limits = 750 queries it can
    // issue as fast as the network allows; no per-minute ceiling in this range
    // changes that outcome. This limiter is the rate bound and MAX_LIMIT is the
    // size bound — do not credit the response cache with either, because on a
    // workers.dev deployment it may store nothing at all (see CACHE_CONTROL in
    // worker/routes/leaderboard.js). What a ceiling CAN do is deny a real group
    // on the lobby's first screen, and that is the direction worth avoiding.
    //
    // The arithmetic: one lobby mount is 1 request, and the client caches per
    // mount, so a racer who flips through every tab spends 15 — one per
    // difficulty/period pair — and then stops. 900/min is 60 of those full
    // sweeps: exactly a NAT'd classroom of 30 each exhausting all 15 tabs
    // twice inside the same minute. As with the limiter above, IP-only keying
    // reads that classroom as one client, which is why the ceiling sits this
    // far above one person's worst case. Counters are per-colo, so this is a
    // floor on what a distributed caller can send, not a global cap.
    {
      "name": "LEADERBOARD_IP_LIMIT",
      "namespace_id": "1003",
      "simple": { "limit": 900, "period": 60 }
    },
    // Quick-match join throttle: 3 joins per device per minute.
    {
      "name": "MATCHMAKING_LIMIT",
      "namespace_id": "1004",
      "simple": { "limit": 3, "period": 60 }
    },
    // Contact form: 1 message per IP per minute (the binding has no hourly window).
    {
      "name": "CONTACT_IP_LIMIT",
      "namespace_id": "1005",
      "simple": { "limit": 1, "period": 60 }
    }
  ],
  // obscenity ships a broken ESM wrapper at dist/index.mjs (does
  // `import mod from "./index.js"` then references `mod.X`, which evaluates
  // to undefined under workerd). Aliasing forces esbuild to resolve the CJS
  // file directly, which works fine under nodejs_compat.
  "alias": {
    "obscenity": "./node_modules/obscenity/dist/index.js"
  },
  "env": {
    "preview": {
      "name": "arithmetic-racer-preview",
      "main": "server/server.js",
      "compatibility_flags": ["nodejs_compat"],
      "assets": {
        "directory": "./public",
        "binding": "ASSETS"
      },
      // As of wrangler 4.88, observability is inherited from the top level;
      // this block is repeated only for explicitness.
      "observability": {
        "enabled": true,
        "head_sampling_rate": 1
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "arithmetic-racer-preview",
          "database_id": "0b3bf14c-e2cb-4f0a-a7f3-40ae344bdcbb"
        }
      ],
      "version_metadata": {
        "binding": "CF_VERSION_METADATA"
      },
      "durable_objects": {
        "bindings": [
          { "name": "RaceRoom",       "class_name": "RaceRoom" },
          { "name": "PublicRaceRoom", "class_name": "PublicRaceRoom" },
          { "name": "LobbyRouter",    "class_name": "LobbyRouter" }
        ]
      },
      "migrations": [
        { "tag": "v1", "new_sqlite_classes": ["RaceRoom"] },
        { "tag": "v2", "new_sqlite_classes": ["PublicRaceRoom", "LobbyRouter"] }
      ],
      // Repeated for the same reason as observability above: named envs do not
      // inherit top-level config, so omitting this ships preview with no
      // limiter and — worse — makes the seam fail open there silently.
      "ratelimits": [
        {
          "name": "RACE_RESULT_LIMIT",
          "namespace_id": "2001",
          "simple": { "limit": 6, "period": 60 }
        },
        {
          "name": "RACE_RESULT_IP_LIMIT",
          "namespace_id": "2002",
          "simple": { "limit": 60, "period": 60 }
        },
        {
          "name": "LEADERBOARD_IP_LIMIT",
          "namespace_id": "2003",
          "simple": { "limit": 900, "period": 60 }
        },
        { "name": "MATCHMAKING_LIMIT", "namespace_id": "2004", "simple": { "limit": 3, "period": 60 } },
        { "name": "CONTACT_IP_LIMIT", "namespace_id": "2005", "simple": { "limit": 1, "period": 60 } }
      ],
      "alias": {
        "obscenity": "./node_modules/obscenity/dist/index.js"
      }
    }
  }
}
